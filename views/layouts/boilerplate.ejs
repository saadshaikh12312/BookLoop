<!DOCTYPE html>
<html lang="en">

<head>
  <%- include("../includes/head") %>
</head>

<body id="page-transition">
  <!-- loader -->
  <div id="page-loader">
    <div class="loader-content">
      <img src="https://res.cloudinary.com/djufaockt/image/upload/v1772485794/l4_gtmcvu.jpg" class="loader-logo" alt="BookLoop">
      <p class="loader-text">Loading ...</p>
    </div>
  </div>

  <!-- page header  -->
  <%- include("../partials/navbar") %>

  <div class="connect-flash position-relative">
    <!-- show success flash message -->
    <% if(success.length){ %>
    <div class="alert alert-success alert-dismissible fade show position-absolute z-2 flash flash-success" role="alert">
      <%= success %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
    <% } %>

    <!-- show error flash message -->
    <% if(error.length){ %>
    <div class="alert alert-danger alert-dismissible fade show position-absolute z-2 flash flash-danger" role="alert">
      <%= error %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
    <% } %>
  </div>

  <!-- body injected here  -->
  <%- body %>

  <!-- page footer  -->
  <%- include("../partials/footer") %>

  <!-- global and page specific js inserted here -->
  <%- include("../includes/foot") %>
</body>

</html>